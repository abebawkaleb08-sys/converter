
// super  Keyword & Overriding

class Account {
    protected double balance;
    Account(double bal) { this.balance = bal; }
    void info() { System.out.println("Balance: " + balance); }
}

class SavingsAccount extends Account {
    SavingsAccount(double bal) { super(bal); }  // Calls parent constructor
    @Override
    void info() {
        super.info();  // Calls parent's info()
        System.out.println("Savings active");
    }
}
